#!/bin/bash
# 把 fnOS 平台下发的真实路径写进 app/docker/docker-compose.yaml 的挂载段。
#
#   TRIM_DATA_SHARE_PATHS       data-share 共享目录（录像的默认位置），冒号分隔，取第一个
#   TRIM_PKGVAR                 应用数据目录（转码缓存放这，升级不丢）
#   TRIM_DATA_ACCESSIBLE_PATHS  用户在「应用设置 → 授权目录」勾选的目录，多值分隔，
#                               只读挂成 /nas/1、/nas/2 ...，网页的文件夹选择器直接能选
#
# 安装、升级、授权变更三个时机各调用一次。compose 里的路径写死是不可靠的——
# 不同 fnOS 版本共享目录的落盘位置不一样，只有平台下发的环境变量是准的。
#
# 全部 TRIM_* 变量会记进 ${TRIM_PKGVAR}/apply_mounts.log（持久），
# 出问题时看这个文件就知道平台到底下发了什么。
set -u

APPNAME="${TRIM_APPNAME:-xiaomi-cam-viewer}"
PKGVAR="${TRIM_PKGVAR:-/usr/local/apps/@appdata/${APPNAME}}"
PLOG="${PKGVAR}/apply_mounts.log"
mkdir -p "$PKGVAR" 2>/dev/null || true
log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$PLOG" 2>/dev/null || true
    [ -n "${TRIM_TEMP_LOGFILE:-}" ] && printf '%s\n' "$*" >>"$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    return 0
}

log "---- apply_mounts 开始 ----"
# 把平台下发的环境变量原样记下来，方便定位是哪个环节没给路径
env | grep '^TRIM_' | sort | while IFS= read -r line; do log "env: ${line}"; done

COMPOSE="${TRIM_COMPOSE:-}"
if [ -z "$COMPOSE" ]; then
    for cand in "/var/apps/${APPNAME}/docker/docker-compose.yaml" \
                "/var/apps/${APPNAME}/app/docker/docker-compose.yaml"; do
        if [ -f "$cand" ]; then
            COMPOSE="$cand"
            break
        fi
    done
fi
if [ -z "$COMPOSE" ]; then
    log "找不到 docker-compose.yaml，跳过挂载生成"
    exit 0
fi
log "compose: ${COMPOSE}"

# ---- 转码缓存：应用数据目录，升级不丢 ----
CACHE="${PKGVAR}/cache"
mkdir -p "$CACHE" 2>/dev/null || true

# ---- 录像目录：优先用平台下发的 data-share 路径 ----
SHARE=""
if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    SHARE="${TRIM_DATA_SHARE_PATHS%%:*}"
fi
if [ -z "$SHARE" ] || [ ! -d "$SHARE" ]; then
    for cand in "/var/apps/${APPNAME}/share/${APPNAME}/videos" \
                "/var/apps/${APPNAME}/share/videos" \
                "/var/apps/${APPNAME}/shares/${APPNAME}/videos" \
                "/var/apps/${APPNAME}/shares/videos"; do
        if [ -d "$cand" ]; then
            SHARE="$cand"
            break
        fi
    done
fi
if [ -z "$SHARE" ]; then
    SHARE="/var/apps/${APPNAME}/share/${APPNAME}/videos"
    mkdir -p "$SHARE" 2>/dev/null || true
    log "未找到 data-share 目录，已创建 ${SHARE}。录像放进这里，或在应用设置里授权别的目录。"
fi

# ---- 用户授权的外部目录，只读挂到 /nas/N ----
# 平台文档说是冒号分隔，但不同版本可能给成逗号 / 换行 / JSON 数组，
# 这里统统接受；解析不出来也记日志，不再无声跳过。
RAW="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
# 去掉 JSON 数组的括号和引号；分隔符只认 : , ; 换行，路径里的空格不能拆
RAW="$(printf '%s' "$RAW" | tr -d '[]' | tr -d "\"'")"
NAS_LINES=""
idx=0
while IFS= read -r p; do
    p="$(printf '%s' "$p" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -n "$p" ] || continue
    if [ ! -d "$p" ]; then
        log "授权路径不存在，跳过: ${p}"
        continue
    fi
    idx=$((idx + 1))
    NAS_LINES="${NAS_LINES}      - ${p}:/nas/${idx}:ro
"
    log "授权路径 #${idx}: ${p}"
done < <(printf '%s\n' "$RAW" | tr ',;:' '\n')
[ -z "$RAW" ] && log "TRIM_DATA_ACCESSIBLE_PATHS 为空（平台没下发，或版本 < 1.1.8）"

BLOCK="      # mounts-begin 由 cmd/apply_mounts 生成，勿手改
      # 录像目录（应用共享目录，文件管理 → 应用文件里可见），只读
      - ${SHARE}:/videos:ro
${NAS_LINES}      # 转码缓存：删掉不影响录像，只影响二次播放是否秒开
      - ${CACHE}:/cache
      # mounts-end"

TMP="${COMPOSE}.tmp.$$"
IN_BLOCK=0
: >"$TMP"
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        *" mounts-begin"*)
            printf '%s\n' "$BLOCK" >>"$TMP"
            IN_BLOCK=1
            continue
            ;;
        *" mounts-end"*)
            IN_BLOCK=0
            continue
            ;;
    esac
    [ "$IN_BLOCK" -eq 0 ] && printf '%s\n' "$line" >>"$TMP"
done <"$COMPOSE"

if grep -q 'mounts-begin' "$TMP"; then
    mv "$TMP" "$COMPOSE"
    log "已写入：录像=${SHARE} 缓存=${CACHE} 授权目录=${idx} 个"
else
    rm -f "$TMP"
    log "${COMPOSE} 里没有 mounts-begin 标记，未改写"
fi

exit 0
