#!/bin/bash
# 升级完成：新包里的 compose 是模板，把持久化的授权目录重新写进 .env。
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -x "${HERE}/sync_env" ]; then
    "${HERE}/sync_env"
fi

VAR="${TRIM_PKGVAR:-}"
if [ -n "$VAR" ] && [ -n "${TRIM_UID:-}" ] && [ -n "${TRIM_GID:-}" ]; then
    chown -R "${TRIM_UID}:${TRIM_GID}" "${VAR}/cache" 2>/dev/null || true
fi

exit 0
