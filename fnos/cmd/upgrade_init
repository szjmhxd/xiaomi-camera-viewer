#!/bin/bash
# 升级前置钩子：fnOS 升级会用新包覆盖 compose 目录，旧的 .env 会没。
# 趁旧文件还在，把上次的授权目录收进 nas_dir.list（PKGVAR 下，升级不丢），
# 升级后的 upgrade_callback → sync_env 就能原样恢复，不用再手动授权一次。
# 兼容 1.3.1 及更早：那时授权结果写在 compose 的 /nas/N 挂载行或 accessible.list。
set -u

APPNAME="${TRIM_APPNAME:-xiaomi-cam-viewer}"
PKGVAR="${TRIM_PKGVAR:-/usr/local/apps/@appdata/${APPNAME}}"
mkdir -p "$PKGVAR" 2>/dev/null || true

COMPOSE=""
for cand in "/vol1/@appcenter/${APPNAME}/docker/docker-compose.yaml" \
            "/var/apps/${APPNAME}/docker/docker-compose.yaml" \
            "/var/apps/${APPNAME}/app/docker/docker-compose.yaml"; do
    [ -f "$cand" ] && COMPOSE="$cand" && break
done

FOUND=""

# 当前版本：compose 用 ${NAS_DIR:-默认}:/nas:ro 变量替换，真实路径存在同目录 .env 里
if [ -n "$COMPOSE" ]; then
    ENVF="$(dirname "$COMPOSE")/.env"
    if [ -f "$ENVF" ]; then
        V="$(grep '^NAS_DIR=' "$ENVF" 2>/dev/null | head -1 | sed 's/^NAS_DIR=//')"
        [ -n "$V" ] && FOUND="$V"
    fi
fi

# 1.3.1 及更早：apply_mounts 直接写进 compose 的 "/路径:/nas/N:ro" 挂载行
if [ -z "$FOUND" ] && [ -n "$COMPOSE" ]; then
    FOUND="$(grep -oE '^[[:space:]]*-[[:space:]]*[^:]+:/nas/[0-9]+:ro' "$COMPOSE" 2>/dev/null \
        | sed 's/^[[:space:]]*-[[:space:]]*//; s|:/nas/[0-9]*:ro$||' \
        | grep -v 'share/xiaomi-cam-viewer' || true)"
fi

# 再旧一点的记法：accessible.list（冒号分隔）
if [ -z "$FOUND" ]; then
    FOUND="$(cat "${PKGVAR}/accessible.list" 2>/dev/null || true)"
fi

if [ -n "$FOUND" ]; then
    printf '%s\n' "$FOUND" | paste -sd: - >"${PKGVAR}/nas_dir.list" 2>/dev/null || true
fi

exit 0
