#!/bin/bash
# 安装完成：按平台下发的路径生成 compose 挂载，准备缓存目录。
set -u

LOG="${TRIM_TEMP_LOGFILE:-/dev/null}"
APPNAME="${TRIM_APPNAME:-xiaomi-cam-viewer}"
HERE="$(cd "$(dirname "$0")" && pwd)"

# 挂载路径由平台环境变量决定，写死不可靠
if [ -x "${HERE}/apply_mounts" ]; then
    "${HERE}/apply_mounts"
fi

VAR="${TRIM_PKGVAR:-}"
if [ -n "$VAR" ]; then
    mkdir -p "${VAR}/cache" 2>/dev/null || true
    if [ -n "${TRIM_UID:-}" ] && [ -n "${TRIM_GID:-}" ]; then
        chown -R "${TRIM_UID}:${TRIM_GID}" "$VAR" 2>/dev/null || true
    fi
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "提示：未检测到 docker 命令，应用可能启动失败。请在飞牛「Docker」中确认服务已开启。" >>"$LOG"
fi

exit 0
